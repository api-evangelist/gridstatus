{
 "info": {
  "name": "Grid Status API",
  "description": "Programmatic access to Grid Status electricity grid and power market data - day-ahead and real-time LMP prices, load, fuel mix, ancillary services, and transmission constraints across CAISO, ERCOT, IESO, ISONE, MISO, NYISO, PJM, and SPP. Base URL: https://api.gridstatus.io/v1. Authenticate with an API key from https://www.gridstatus.io/settings/api in the x-api-key header.",
  "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
 },
 "auth": {
  "type": "apikey",
  "apikey": [
   {
    "key": "key",
    "value": "x-api-key",
    "type": "string"
   },
   {
    "key": "value",
    "value": "{{apiKey}}",
    "type": "string"
   },
   {
    "key": "in",
    "value": "header",
    "type": "string"
   }
  ]
 },
 "variable": [
  {
   "key": "baseUrl",
   "value": "https://api.gridstatus.io/v1"
  },
  {
   "key": "apiKey",
   "value": ""
  }
 ],
 "item": [
  {
   "name": "API Info",
   "item": [
    {
     "name": "Get API info",
     "request": {
      "method": "GET",
      "header": [],
      "url": {
       "raw": "{{baseUrl}}/",
       "host": [
        "{{baseUrl}}"
       ],
       "path": []
      },
      "description": "Returns the API name and version."
     }
    }
   ]
  },
  {
   "name": "Datasets",
   "item": [
    {
     "name": "List datasets",
     "request": {
      "method": "GET",
      "header": [],
      "url": {
       "raw": "{{baseUrl}}/datasets",
       "host": [
        "{{baseUrl}}"
       ],
       "path": [
        "datasets"
       ]
      },
      "description": "List all published datasets you have access to."
     }
    },
    {
     "name": "Get dataset metadata",
     "request": {
      "method": "GET",
      "header": [],
      "url": {
       "raw": "{{baseUrl}}/datasets/:dataset_id",
       "host": [
        "{{baseUrl}}"
       ],
       "path": [
        "datasets",
        ":dataset_id"
       ],
       "variable": [
        {
         "key": "dataset_id",
         "value": ""
        }
       ]
      },
      "description": "Fetch metadata for a single dataset - columns, time range, frequency, source."
     }
    },
    {
     "name": "Get dataset audit",
     "request": {
      "method": "GET",
      "header": [],
      "url": {
       "raw": "{{baseUrl}}/datasets/:dataset_id/audit",
       "host": [
        "{{baseUrl}}"
       ],
       "path": [
        "datasets",
        ":dataset_id",
        "audit"
       ],
       "variable": [
        {
         "key": "dataset_id",
         "value": ""
        }
       ]
      },
      "description": "Ingest audit history for a dataset."
     }
    },
    {
     "name": "Get dataset updates",
     "request": {
      "method": "GET",
      "header": [],
      "url": {
       "raw": "{{baseUrl}}/dataset-updates/:dataset_id",
       "host": [
        "{{baseUrl}}"
       ],
       "path": [
        "dataset-updates",
        ":dataset_id"
       ],
       "variable": [
        {
         "key": "dataset_id",
         "value": ""
        }
       ]
      },
      "description": "Recent row insert/update activity for a dataset, including backfills."
     }
    }
   ]
  },
  {
   "name": "Query Data",
   "item": [
    {
     "name": "Query a dataset",
     "request": {
      "method": "GET",
      "header": [],
      "url": {
       "raw": "{{baseUrl}}/datasets/:dataset_id/query?start_time=&end_time=&limit=&resample_frequency=&return_format=",
       "host": [
        "{{baseUrl}}"
       ],
       "path": [
        "datasets",
        ":dataset_id",
        "query"
       ],
       "variable": [
        {
         "key": "dataset_id",
         "value": ""
        }
       ],
       "query": [
        {
         "key": "start_time",
         "value": "",
         "description": "Start of the time range (ISO 8601)."
        },
        {
         "key": "end_time",
         "value": "",
         "description": "End of the time range (ISO 8601)."
        },
        {
         "key": "limit",
         "value": "",
         "description": "Maximum rows to return across all pages."
        },
        {
         "key": "resample_frequency",
         "value": "",
         "description": "Resample frequency, e.g. 1 hour or 1 day."
        },
        {
         "key": "return_format",
         "value": "",
         "description": "json or csv."
        }
       ]
      },
      "description": "Query dataset rows (e.g. ercot_spp_day_ahead_hourly day-ahead prices) with time filters, resampling, pagination, and JSON or CSV output."
     }
    },
    {
     "name": "Query a dataset by column value",
     "request": {
      "method": "GET",
      "header": [],
      "url": {
       "raw": "{{baseUrl}}/datasets/:dataset_id/query/:filter_column_id/:filter_value_path",
       "host": [
        "{{baseUrl}}"
       ],
       "path": [
        "datasets",
        ":dataset_id",
        "query",
        ":filter_column_id",
        ":filter_value_path"
       ],
       "variable": [
        {
         "key": "dataset_id",
         "value": ""
        },
        {
         "key": "filter_column_id",
         "value": ""
        },
        {
         "key": "filter_value_path",
         "value": ""
        }
       ]
      },
      "description": "Shortcut query filtered by a single column value, such as a settlement point or location."
     }
    }
   ]
  },
  {
