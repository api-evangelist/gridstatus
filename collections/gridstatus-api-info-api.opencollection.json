{
  "opencollection": "1.0.0",
  "info": {
    "name": "Grid Status API Info API",
    "version": "1.3.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "x-api-key",
      "value": "{{x-api-key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "API Info",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "API Info",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.gridstatus.io/v1/"
          },
          "docs": "Returns the API name and version."
        }
      ]
    }
  ],
  "bundled": true
}