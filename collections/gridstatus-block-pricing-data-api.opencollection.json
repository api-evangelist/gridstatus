{
  "opencollection": "1.0.0",
  "info": {
    "name": "Grid Status API Info Block Pricing Data API",
    "version": "1.3.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "x-api-key",
      "value": "{{x-api-key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Block Pricing Data",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get block pricing",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.gridstatus.io/v1/block-pricing/:iso",
            "params": [
              {
                "name": "iso",
                "value": "",
                "type": "path",
                "description": "ISO/RTO identifier."
              }
            ]
          },
          "docs": "Returns volume-weighted block-averaged prices for an ISO over the requested date range. The response is a list of columns - daily columns keyed by ISO date plus appended summary columns such as MTD (month-to-date) and a Month-Year label for each full month spanned."
        }
      ]
    }
  ],
  "bundled": true
}