          "name": "Get block pricing",
          "request": {
            "name": "Get block pricing",
            "description": {
              "content": "Returns volume-weighted block-averaged prices for an ISO over the requested date range. The response is a list of columns - daily columns keyed by ISO date plus appended summary columns such as MTD (month-to-date) and a Month-Year label for each full month spanned.",
              "type": "text/plain"
            },
