{
  "item": [
    {
      "id": "5d29f13b-c121-469b-bb92-02079c53c255",
      "name": "Query Data",
      "description": {
        "content": "Query dataset rows with filters, resampling, and pagination.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "31a5fde8-eb92-4790-b4cc-40fdf2108371",
          "name": "Query a dataset",
          "request": {
            "name": "Query a dataset",
            "description": {
              "content": "Query a dataset and return matching rows as JSON or CSV. Example dataset IDs include ercot_spp_day_ahead_hourly (ERCOT day-ahead settlement point prices), ercot_fuel_mix, ercot_as_prices, caiso_load, caiso_lmp_real_time_5_min, and pjm_lmp_real_time_5_min. Pass the X-Stream true request header to stream JSON rows from a server-side cursor instead of buffering the whole result (JSON only); in streaming mode read pagination from the JSON meta.hasNextPage and meta.cursor fields.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "datasets",
                ":dataset_id",
                "query"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "start_time",
                  "value": "<string>",
                  "description": "Start of the time range filter on the dataset's time index column (ISO 8601). Rows on or after this time are returned."
                },
                {
                  "disabled": false,
                  "key": "end_time",
                  "value": "<string>",
                  "description": "End of the time range filter on the dataset's time index column (ISO 8601). Rows before this time are returned."
                },
                {
                  "disabled": false,
                  "key": "time",
                  "value": "<string>",
                  "description": "Point-in-time filter. Accepts 'latest' or an ISO 8601 timestamp. Cannot be combined with start_time or end_time."
                },
                {
                  "disabled": false,
                  "key": "time_comparison",
                  "value": "<string>",
                  "description": "Comparison operator used when filtering by time."
                },
                {
                  "disabled": false,
                  "key": "publish_time",
                  "value": "<string>",
                  "description": "Filter based on the dataset's publish time column."
                },
                {
                  "disabled": false,
                  "key": "publish_time_start",
                  "value": "<string>",
                  "description": "Start of a publish-time range filter."
                },
                {
                  "disabled": false,
                  "key": "publish_time_end",
                  "value": "<string>",
                  "description": "End of a publish-time range filter."
                },
                {
                  "disabled": false,
                  "key": "filter_column",
                  "value": "<string>",
                  "description": "The column to filter results by (for example location)."
                },
                {
                  "disabled": false,
                  "key": "filter_value",
                  "value": "<string>",
                  "description": "The value to filter results by."
                },
                {
                  "disabled": false,
                  "key": "filter_operator",
                  "value": "=",
                  "description": "Operator applied between filter_column and filter_value."
                },
                {
                  "disabled": false,
                  "key": "columns",
                  "value": "<string>",
                  "description": "Comma separated list of columns to return. Defaults to all columns."
                },
                {
                  "disabled": false,
                  "key": "order",
                  "value": "<string>",
                  "description": "Sort order of results."
                },
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "<integer>",
                  "description": "Maximum number of rows to return across all pages."
                },
                {
                  "disabled": false,
                  "key": "page",
                  "value": "1",
                  "description": "Page number of results to return."
                },
                {
                  "disabled": false,
                  "key": "page_size",
                  "value": "<integer>",
                  "description": "Maximum number of rows to return in a single page."
                },
                {
                  "disabled": false,
                  "key": "cursor",
                  "value": "<string>",
                  "description": "Cursor for cursor-based pagination."
                },
                {
                  "disabled": false,
                  "key": "timezone",
                  "value": "<string>",
                  "description": "Timezone used when interpreting timezone-naive timestamps and when resampling to frequencies of one day or longer."
                },
                {
                  "disabled": false,
                  "key": "resample_frequency",
                  "value": "<string>",
                  "description": "Frequency to resample the data to, from '1 minute' through '1 year' (for example '5 minutes', '1 hour', '1 day', '1 month')."
                },
                {
                  "disabled": false,
                  "key": "resample_by",
                  "value": "<string>",
                  "description": "Comma separated list of columns to group by before resampling."
                },
                {
                  "disabled": false,
                  "key": "resample_function",
                  "value": "mean",
                  "description": "Aggregation function used when resampling."
                },
                {
                  "disabled": false,
                  "key": "return_format",
                  "value": "json",
                  "description": "The return format of the response."
                },
                {
                  "disabled": false,
                  "key": "json_schema",
                  "value": "array-of-objects",
                  "description": "Shape of the JSON response."
                },
                {
                  "disabled": false,
                  "key": "download",
                  "value": "false",
                  "description": "Whether to return the result as a file download."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "dataset_id",
                  "description": "(Required) ID of the dataset (for example ercot_spp_day_ahead_hourly)."
                }
              ]
            },
            "header": [
              {
                "disabled": false,
                "description": "Set to true to stream JSON rows from a server-side cursor.",
                "key": "X-Stream",
                "value": "<boolean>"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
          "response": [
