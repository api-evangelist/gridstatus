                  "type": "any",
                  "value": "<string>",
                  "key": "dataset_id",
                  "description": "(Required) ID of the dataset (for example ercot_spp_day_ahead_hourly)."
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "filter_column_id",
                  "description": "(Required) The column to filter by."
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "filter_value_path",
                  "description": "(Required) The value to filter the column by."
                }
              ]
            },
